# Local development. Copy to .env and adjust.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hustl?schema=public"

# Must be stable across restarts (changing them invalidates sessions / OTP codes).
SESSION_SECRET="dev-session-secret-change-me-please"
OTP_PEPPER="dev-otp-pepper-change-me-please"

# Email. Without a key the app still works end to end: codes surface in DEMO_MODE.
# RESEND_API_KEY="re_..."
EMAIL_FROM="HUSTL <login@yourdomain.com>"

ALLOWED_EMAIL_DOMAIN="uw.edu"

# 1 = OTP codes echoed on screen + persona switcher. NEVER set in production.
DEMO_MODE="1"

# 7 days in production. 120000 (2 min) makes auto-complete demoable on stage.
AUTO_COMPLETE_MS="120000"
REQUEST_DEFAULT_TTL_MS="259200000"
