    "next": "16.4.0",
    "pg": "^8.13.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.32.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24",
    "@types/pg": "^8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.0",
    "eslint": "^10",
    "eslint-config-next": "16.4.0",
    "postcss": "^8.5.29",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
