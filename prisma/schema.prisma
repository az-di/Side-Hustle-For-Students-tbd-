// HUSTL — campus marketplace for student creative services.
//
// Money rules (see src/lib/money.ts):
//   * every amount is Int CENTS, never Float
//   * buyer-authored amounts are GROSS (a ceiling) and must never reach a seller surface
//   * seller-authored amounts are NET (what they take home) and are safe to show anyone
//   * feeBps is frozen per row, so changing the platform fee never restates old jobs

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────── identity ────────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED // auto or admin; can sign in to read, cannot act
  CLOSED // admin only; cannot sign in
}

model User {
  id          String     @id @default(cuid())
  uwEmail     String     @unique // lowercased; a CHECK constraint enforces @uw.edu
  handle      String     @unique
  displayName String
  bio         String?
  avatarUrl   String?
  venmoHandle String? // revealed only to the counterparty of an existing job
  isDemo      Boolean    @default(false)
  isAdmin     Boolean    @default(false)
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Email preferences. The unsubscribe link carries an HMAC of emailUnsubKey,
  // so a one-click unsubscribe needs no session and the key never leaves the
  // server in the clear.
  emailOptOut   Boolean @default(false)
  // DB-level default so existing rows get a key when the column is added.
  emailUnsubKey String  @unique @default(dbgenerated("gen_random_uuid()::text"))

  outboundEmails OutboundEmail[]
  mediaAssets    MediaAsset[]
  portfolioItems PortfolioItem[]
  trust          UserTrust?
  blocksMade     Block[]  @relation("BlocksMade")
  blocksReceived Block[]  @relation("BlocksReceived")
  reportsMade    Report[] @relation("ReportsMade")
  reportsAgainst Report[] @relation("ReportsAgainst")

  sellerProfile      SellerProfile?
  sessions           Session[]
  sellerTags         SellerTag[]
  listings           Listing[]
  buyerRequests      Request[]         @relation("BuyerRequests")
  targetedRequests   Request[]         @relation("TargetSellerRequests")
  responses          RequestResponse[]
  buyerJobs          Job[]             @relation("BuyerJobs")
  sellerJobs         Job[]             @relation("SellerJobs")
  buyerThreads       Thread[]          @relation("BuyerThreads")
  sellerThreads      Thread[]          @relation("SellerThreads")
  messages           Message[]
  reviewsWritten     Review[]          @relation("ReviewsWritten")
  reviewsReceived    Review[]          @relation("ReviewsReceived")
  notifications      Notification[]    @relation("NotificationRecipient")
  actedNotifications Notification[]    @relation("NotificationActor")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique // sha256 of the cookie value; the raw token is never stored
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model OtpChallenge {
  id         String    @id @default(cuid())
  email      String // normalized, must be @uw.edu
  codeHash   String // HMAC-SHA256(code, OTP_PEPPER)
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([email, createdAt(sort: Desc)])
  @@index([expiresAt])
}

model SellerProfile {
  userId             String    @id
  headline           String?
  about              String?
  isAvailable        Boolean   @default(true) // false == paused: still listed, no new requests
  pausedAt           DateTime?
  fixedPriceCents    Int? // NET
  hourlyRateCents    Int? // NET
  portfolioLinks     String[]  @default([])
  ratingAvg          Float?
  ratingCount        Int       @default(0)
  completedJobCount  Int       @default(0) // MUTUAL completions only
  autoCompletedCount Int       @default(0)
  createdAt          DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isAvailable, ratingAvg(sort: Desc)])
}

// ──────────────────────────────── catalog ─────────────────────────────────

enum TagKind {
  SERVICE
  COURSE
}

model Tag {
  id   String  @id @default(cuid())
  kind TagKind
  slug String  @unique
  name String

  // Name plus HIDDEN synonyms, all lowercased. Never returned to a client:
  // echoing a matched term would let anyone enumerate the synonym list.
  searchTerms String[] @default([])
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(100)

  sellerTags  SellerTag[]
  listingTags ListingTag[]
  requestTags RequestTag[]

  @@index([kind, isActive, sortOrder])
}

model SellerTag {
  sellerUserId String
  tagId        String
  createdAt    DateTime @default(now())

  seller User @relation(fields: [sellerUserId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([sellerUserId, tagId])
  @@index([tagId, sellerUserId]) // the open-request fan-out index
}

model Listing {
  id              String   @id @default(cuid())
  sellerUserId    String
  title           String
  description     String
  fixedPriceCents Int? // NET
  hourlyRateCents Int? // NET
  turnaroundDays  Int?
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  seller   User         @relation(fields: [sellerUserId], references: [id], onDelete: Cascade)
  tags     ListingTag[]
  requests Request[]

  @@index([sellerUserId, isPublished])
}

model ListingTag {
  listingId String
  tagId     String

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([listingId, tagId])
  @@index([tagId, listingId])
}

// ──────────────────────────────── requests ────────────────────────────────

enum RequestKind {
  OPEN
  DIRECT
}

enum RequestStatus {
  PENDING_SELLER // DIRECT, awaiting the seller
  OPEN // broadcast, collecting responses
  MATCHED
  DECLINED
  EXPIRED
  CANCELLED
}

enum ResponseStatus {
  PENDING
  WITHDRAWN
  SELECTED
  SUPERSEDED
}

model Request {
  id                 String      @id @default(cuid())
  buyerUserId        String
  kind               RequestKind
  targetSellerUserId String? // DIRECT only
  listingId          String?
  title              String
  details            String

  // GROSS — the buyer's ceiling. Never selected by a seller-facing read.
  grossFixedBudgetCents  Int?
  grossHourlyBudgetCents Int?
  feeBps                 Int     @default(1000) // frozen at creation

  status           RequestStatus
  expiresAt        DateTime
  chosenResponseId String?       @unique
  closedAt         DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  buyer          User              @relation("BuyerRequests", fields: [buyerUserId], references: [id], onDelete: Cascade)
  targetSeller   User?             @relation("TargetSellerRequests", fields: [targetSellerUserId], references: [id])
  listing        Listing?          @relation(fields: [listingId], references: [id])
  tags           RequestTag[]
  responses      RequestResponse[] @relation("RequestResponses")
  chosenResponse RequestResponse?  @relation("ChosenResponse", fields: [chosenResponseId], references: [id])
  job            Job?
  threads        Thread[]
  notifications  Notification[]

  @@index([status, expiresAt]) // expiry sweep + feed filtering
  @@index([buyerUserId, status, createdAt(sort: Desc)])
  @@index([targetSellerUserId, status, createdAt(sort: Desc)])
}

model RequestTag {
  requestId String
  tagId     String

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([requestId, tagId])
  @@index([tagId, requestId])
}

model RequestResponse {
  id           String         @id @default(cuid())
  requestId    String
  sellerUserId String
  message      String
  status       ResponseStatus @default(PENDING)
  createdAt    DateTime       @default(now())

  request  Request  @relation("RequestResponses", fields: [requestId], references: [id], onDelete: Cascade)
  seller   User     @relation(fields: [sellerUserId], references: [id], onDelete: Cascade)
  chosenBy Request? @relation("ChosenResponse")
  thread   Thread?

  @@unique([requestId, sellerUserId]) // one response per seller per request
  @@index([sellerUserId, status, createdAt(sort: Desc)])
}

// ────────────────────────────────── jobs ──────────────────────────────────

enum JobStatus {
  IN_PROGRESS
  AWAITING_CONFIRMATION
  COMPLETED
  CANCELLED
}

enum CompletionSource {
  MUTUAL
  AUTO
}

model Job {
  id           String @id @default(cuid())
  requestId    String @unique // one job per request
  buyerUserId  String
  sellerUserId String

  agreedGrossFixedCents  Int? // GROSS snapshot taken at match
  agreedGrossHourlyCents Int?
  feeBps                 Int  @default(1000)

  status                  JobStatus         @default(IN_PROGRESS)
  completionRequestedById String?
  completionRequestedAt   DateTime?
  autoCompleteAt          DateTime?
  completedAt             DateTime?
  completionSource        CompletionSource?
  cancelledAt             DateTime?
  cancelledById           String?
  createdAt               DateTime          @default(now())

  request       Request        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  buyer         User           @relation("BuyerJobs", fields: [buyerUserId], references: [id], onDelete: Cascade)
  seller        User           @relation("SellerJobs", fields: [sellerUserId], references: [id], onDelete: Cascade)
  review        Review?
  thread        Thread?
  notifications Notification[]
  reports       Report[]

  @@index([status, autoCompleteAt]) // auto-complete sweep
  @@index([sellerUserId, status, createdAt(sort: Desc)])
  @@index([buyerUserId, status, createdAt(sort: Desc)])
}

// ──────────────────────────────── messaging ───────────────────────────────

enum ThreadKind {
  INQUIRY
  REQUEST
  JOB
}

enum SystemMessageKind {
  REQUEST_CREATED
  RESPONSE_SENT
  REQUEST_MATCHED
  REQUEST_CLOSED
  JOB_STARTED
  COMPLETION_REQUESTED
  COMPLETION_CONFIRMED
  JOB_AUTO_COMPLETED
  JOB_CANCELLED
}

model Thread {
  id                String     @id @default(cuid())
  kind              ThreadKind
  buyerUserId       String
  sellerUserId      String
  requestId         String?
  requestResponseId String?    @unique // OPEN requests get one thread per responder
  jobId             String?    @unique
  lastMessageAt     DateTime   @default(now())
  lastReadBuyerAt   DateTime?
  lastReadSellerAt  DateTime?
  createdAt         DateTime   @default(now())

  buyer           User             @relation("BuyerThreads", fields: [buyerUserId], references: [id], onDelete: Cascade)
  seller          User             @relation("SellerThreads", fields: [sellerUserId], references: [id], onDelete: Cascade)
  request         Request?         @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestResponse RequestResponse? @relation(fields: [requestResponseId], references: [id], onDelete: Cascade)
  job             Job?             @relation(fields: [jobId], references: [id])
  messages        Message[]
  notifications   Notification[]

  @@index([buyerUserId, lastMessageAt(sort: Desc)])
  @@index([sellerUserId, lastMessageAt(sort: Desc)])
}

model Message {
  id           String             @id @default(cuid())
  threadId     String
  senderUserId String? // null for system messages
  systemKind   SystemMessageKind?

  // A thread is read by BOTH parties, so this is a seller-facing surface:
  // system messages must never contain a money figure.
  body      String
  createdAt DateTime @default(now())

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User?  @relation(fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

// ──────────────────────────────── reviews ─────────────────────────────────

model Review {
  id           String   @id @default(cuid())
  jobId        String   @unique // one review per job, enforced by the DB
  buyerUserId  String
  sellerUserId String
  rating       Int // a CHECK constraint enforces 1..5
  body         String?
  createdAt    DateTime @default(now())

  job    Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  buyer  User @relation("ReviewsWritten", fields: [buyerUserId], references: [id], onDelete: Cascade)
  seller User @relation("ReviewsReceived", fields: [sellerUserId], references: [id], onDelete: Cascade)

  @@index([sellerUserId, createdAt(sort: Desc)])
}

// ───────────────────────────── notifications ──────────────────────────────

enum NotificationKind {
  DIRECT_REQUEST_RECEIVED
  OPEN_REQUEST_IN_TAG
  RESPONSE_RECEIVED
  RESPONSE_SELECTED
  RESPONSE_NOT_SELECTED
  REQUEST_DECLINED
  REQUEST_CANCELLED
  REQUEST_EXPIRED
  JOB_STARTED
  COMPLETION_REQUESTED
  JOB_COMPLETED
  JOB_AUTO_COMPLETED
  JOB_CANCELLED
  REVIEW_RECEIVED
  MESSAGE_RECEIVED
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  kind        NotificationKind
  requestId   String?
  jobId       String?
  threadId    String?
  actorUserId String?

  // Ids only — never a rendered string like "New request: $100 for photos".
  // Notification rows are role-blind, so money is rendered per viewer at read time.
  dedupeKey String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user    User     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor   User?    @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  request Request? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  job     Job?     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  thread  Thread?  @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey]) // makes fan-out and retries idempotent
  @@index([userId, createdAt(sort: Desc)])
}

// ───────────────────────────── trust and safety ───────────────────────────

enum ReportKind {
  NO_SHOW
  ABUSIVE
  SCAM
  ACADEMIC_DISHONESTY
  OFF_PLATFORM_PRESSURE
  SPAM
  OTHER
}

enum ReportStatus {
  OPEN
  UPHELD
  DISMISSED
}

model Report {
  id             String       @id @default(cuid())
  reporterUserId String
  subjectUserId  String
  kind           ReportKind
  reason         String
  jobId          String?
  // jobId, or "general" when the report is not about one job. Postgres treats
  // NULLs as distinct in a unique index, so the nullable column cannot carry
  // the "one report per job per reporter" rule on its own.
  scopeKey       String
  status         ReportStatus @default(OPEN)
  weight         Int          @default(1) // frozen at creation; see trust/state.ts
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())

  reporter User @relation("ReportsMade", fields: [reporterUserId], references: [id], onDelete: Cascade)
  subject  User @relation("ReportsAgainst", fields: [subjectUserId], references: [id], onDelete: Cascade)
  job      Job? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@unique([reporterUserId, subjectUserId, scopeKey])
  @@index([subjectUserId, status])
  @@index([status, createdAt(sort: Desc)])
}

model Block {
  blockerUserId String
  blockedUserId String
  createdAt     DateTime @default(now())

  blocker User @relation("BlocksMade", fields: [blockerUserId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@id([blockerUserId, blockedUserId])
  @@index([blockedUserId, blockerUserId]) // reverse lookup for feeds
}

/// Internal standing. Never leaves admin surfaces or this module.
model UserTrust {
  userId              String    @id
  negativeReportCount Int       @default(0) // sum of weights over OPEN + UPHELD reports
  autoSuspendedAt     DateTime?
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Tunable numbers that must not need a deploy to change. Read via trust/settings.ts.
model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ────────────────────────────────── media ─────────────────────────────────

enum MediaKind {
  IMAGE
  VIDEO
  PDF
}

/// A file on the media volume (MEDIA_DIR), served by /media/[key]. The row
/// is the source of truth for the content type: the extension in storageKey
/// is cosmetic. Type is decided by sniffing the bytes, never by the upload's
/// declared MIME type.
model MediaAsset {
  id          String    @id @default(cuid())
  ownerUserId String
  kind        MediaKind
  mimeType    String
  bytes       Int
  storageKey  String    @unique // "<random>.<ext>", no path separators
  createdAt   DateTime  @default(now())

  owner         User           @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  portfolioItem PortfolioItem?

  @@index([ownerUserId, createdAt(sort: Desc)])
}

/// One tile in a seller's portfolio. Links live in SellerProfile.portfolioLinks;
/// this is for hosted media.
model PortfolioItem {
  id           String   @id @default(cuid())
  sellerUserId String
  assetId      String   @unique
  caption      String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  seller User       @relation(fields: [sellerUserId], references: [id], onDelete: Cascade)
  asset  MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([sellerUserId, sortOrder, createdAt])
}

// ──────────────────────────────── email outbox ────────────────────────────

enum EmailStatus {
  PENDING
  SENT
  FAILED // gave up after MAX_ATTEMPTS
  SKIPPED // recipient opted out, or nothing left to say by the time it was due
}

/// Every email leaves through this table. Rows are written in the SAME
/// transaction as the notification they describe, so a crash between "state
/// changed" and "email sent" loses nothing — the drain picks it up later.
///
/// Payloads hold IDS ONLY, like Notification rows: the template renders per
/// recipient at send time, so a money figure can never be pre-baked into a
/// row that might go to a seller.
model OutboundEmail {
  id          String      @id @default(cuid())
  userId      String
  template    String // key into email/templates.ts
  payload     Json // ids only
  /// Unique per logical email, so retries and re-run sweeps are idempotent.
  /// Digests use `digest:{userId}:{bucket}`, which is how several fan-outs
  /// collapse into one message.
  dedupeKey   String      @unique
  status      EmailStatus @default(PENDING)
  sendAfter   DateTime    @default(now())
  attempts    Int         @default(0)
  lastError   String?
  sentAt      DateTime?
  createdAt   DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, sendAfter]) // the drain
  @@index([userId, createdAt(sort: Desc)])
}
